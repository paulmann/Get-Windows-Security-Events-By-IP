# Normalize line endings: the module ships cross-platform.
* text=auto eol=lf

*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf
*.ps1xml text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf

# Windows command scripts require CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.nupkg binary
*.evtx  binary
